# Copy to .env.local and fill in. Never commit real values. All PayPal values are SANDBOX credentials.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# Sandbox Personal (buyer) account: the robot customer pays with it, and the demo page shows it to visitors
PAYPAL_BUYER_EMAIL=your_sandbox_personal_account_email_here
PAYPAL_BUYER_PASSWORD=your_sandbox_personal_account_password_here

# Classic NVP/SOAP API credentials from the sandbox Business account profile (needed by the legacy "before" shop)
PAYPAL_NVP_USER=
PAYPAL_NVP_PWD=
PAYPAL_NVP_SIGNATURE=

# Webhook id (sandbox app > Webhooks), needed by the migrated shop's webhook handler once it has a public URL
PAYPAL_WEBHOOK_ID=

# Protects the shops' admin endpoints (order list, refund). Any long random string.
ADMIN_TOKEN=

# AI for the migration agent (Gemini has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated model order (default: gemini-2.5-flash,gemini-3.1-flash-lite)
GEMINI_MODELS=
